# Copy to .env for local dev (never commit the real .env).
# Paste the key with NO trailing spaces/newline — the app strips it, but be clean anyway.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides:
# DEMO_MODEL=claude-sonnet-4-5
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Where a captured demo lead is forwarded (a demo lead = a PGT sales lead). Any URL that
# accepts a JSON POST: the future PGT admin backend, or an interim webhook (Web3Forms/Zapier).
# If unset, leads are only logged, not delivered.
# LEAD_WEBHOOK_URL=https://your-endpoint.example/lead
